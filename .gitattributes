# normalize line endings: prettier enforces lf, so the repo must check out
# with lf everywhere (windows runners default to crlf without this)
* text=auto eol=lf

# windows-only scripts genuinely need crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# binaries
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
